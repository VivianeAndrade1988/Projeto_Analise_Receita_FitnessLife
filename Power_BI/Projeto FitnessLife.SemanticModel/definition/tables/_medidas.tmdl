	measure 'Insight Atividades' = ```
			
			
			VAR AnoAtual =
			    SELECTEDVALUE(vw_dim_data[ano])
			
			VAR AnoAnterior =
			    AnoAtual - 1
			
			//-------------------------------------------------
			// VARIAÇÃO GERAL DA RECEITA
			//-------------------------------------------------
			
			VAR VarReceita =
			    [Crescimento %]
			
			//-------------------------------------------------
			// TABELA DAS ATIVIDADES
			//-------------------------------------------------
			
			VAR TabelaAtividade =
			    ADDCOLUMNS(
			
			        VALUES(vw_dim_atividades[tipo_atividade]),
			
			        //-----------------------------------
			        -- VARIAÇÃO %
			        //-----------------------------------
			
			        "@VarPerc",
			        [Crescimento %],
			
			        //-----------------------------------
			        -- RECEITA ATUAL
			        //-----------------------------------
			
			        "@ReceitaAtual",
			        [Receita Total],
			
			        //-----------------------------------
			        -- IMPACTO FINANCEIRO
			        //-----------------------------------
			
			        "@Impacto",
			        [Receita Total] - [Receita Ano Anterior]
			    )
			
			//-------------------------------------------------
			// MAIOR FATURAMENTO OU MAIOR PREJUÍZO
			//-------------------------------------------------
			
			VAR MelhorResultado =
			
			    IF(
			
			        //-----------------------------------
			        -- CRESCIMENTO
			        //-----------------------------------
			
			        VarReceita > 0,
			
			        MAXX(
			            TabelaAtividade,
			            [@ReceitaAtual]
			        ),
			
			        //-----------------------------------
			        -- QUEDA
			        //-----------------------------------
			
			        MINX(
			            TabelaAtividade,
			            [@Impacto]
			        )
			    )
			
			//-------------------------------------------------
			// ATIVIDADE DE DESTAQUE
			//-------------------------------------------------
			
			VAR AtividadeDestaque =
			
			    MAXX(
			
			        FILTER(
			
			            TabelaAtividade,
			
			            IF(
			
			                VarReceita > 0,
			
			                [@ReceitaAtual] = MelhorResultado,
			
			                [@Impacto] = MelhorResultado
			            )
			        ),
			
			        vw_dim_atividades[tipo_atividade]
			    )
			
			//-------------------------------------------------
			// PERCENTUAL DA ATIVIDADE
			//-------------------------------------------------
			
			VAR PercentualAtividade =
			
			    MAXX(
			
			        FILTER(
			
			            TabelaAtividade,
			
			            IF(
			
			                VarReceita > 0,
			
			                [@ReceitaAtual] = MelhorResultado,
			
			                [@Impacto] = MelhorResultado
			            )
			        ),
			
			        [@VarPerc]
			    )
			
			//-------------------------------------------------
			// FATURAMENTO
			//-------------------------------------------------
			
			VAR FaturamentoAtividade =
			
			    MAXX(
			
			        FILTER(
			
			            TabelaAtividade,
			
			            [@ReceitaAtual] =
			                MAXX(
			                    TabelaAtividade,
			                    [@ReceitaAtual]
			                )
			        ),
			
			        [@ReceitaAtual]
			    )
			
			//-------------------------------------------------
			// PREJUÍZO
			//-------------------------------------------------
			
			VAR PrejuizoAtividade =
			
			    MINX(
			        TabelaAtividade,
			        [@Impacto]
			    )
			
			//-------------------------------------------------
			// IMPACTO POSITIVO TOTAL
			//-------------------------------------------------
			
			VAR CrescimentoTotalReceita =
			
			    CALCULATE(
			
			        [Receita Total] - [Receita Ano Anterior],
			
			        ALL(vw_dim_atividades)
			    )
			
			//-------------------------------------------------
			// PARTICIPAÇÃO NO CRESCIMENTO
			//-------------------------------------------------
			
			VAR ImpactoPercentualPositivo =
			
			    DIVIDE(
			
			        FaturamentoAtividade,
			
			        CALCULATE(
			            [Receita Total],
			            ALL(vw_dim_atividades)
			        )
			    )
			
			//-------------------------------------------------
			// PARTICIPAÇÃO NA QUEDA
			//-------------------------------------------------
			
			VAR ImpactoPercentualNegativo =
			
			    DIVIDE(
			
			        ABS(PrejuizoAtividade),
			
			        ABS(CrescimentoTotalReceita)
			    )
			
			RETURN
			
			IF(
			
			    //-------------------------------------------------
			    -- CRESCIMENTO
			    //-------------------------------------------------
			
			    VarReceita > 0,
			
			    "📈 Em " &
			    AnoAtual &
			    ", " &
			    AtividadeDestaque &
			    " foi a atividade com maior impacto positivo na receita, apresentando crescimento de " &
			    FORMAT(
			        ABS(PercentualAtividade),
			        "0,0%"
			    ) &
			    " em relação a " &
			    AnoAnterior &
			    "." &
			
			    UNICHAR(10) &
			   
			    "• A atividade faturou " &
			    FORMAT(
			        FaturamentoAtividade,
			        "R$ #,##0"
			    ) &
			
			    " e representou " &
			    FORMAT(
			        ImpactoPercentualPositivo,
			        "0%"
			    ) &
			    " da receita total do período.",
			
			
			    //-------------------------------------------------
			    -- QUEDA
			    //-------------------------------------------------
			
			    "📉 Em " &
			    AnoAtual &
			    ", " &
			    AtividadeDestaque &
			    " apresentou o maior impacto negativo na receita, com redução de " &
			    FORMAT(
			        ABS(PercentualAtividade),
			        "0,0%"
			    ) &
			    " em relação a " &
			    AnoAnterior &
			    "." &
			
			    UNICHAR(10) &
			  
			
			    "• A atividade gerou prejuízo de " &
			    FORMAT(
			        ABS(PrejuizoAtividade),
			        "R$ #,##0"
			    ) &
			
			    ", representando " &
			    FORMAT(
			        ImpactoPercentualNegativo,
			        "0%"
			    ) &
			    " da queda total da receita."
			)
			```
		displayFolder: _INSIGHTS
		lineageTag: eecbbad0-4922-4458-8368-39c63801c969

	measure 'Recomendação Estratégica' =
			
			
			VAR VarClientes =
			    [% clientes vs ano anterior]
			
			VAR VarTicket =
			    [% ticket medio vs ano anterior]
			
			VAR VarReceita =
			    [Crescimento %]
			
			VAR AtividadeCritica =
			    [Atividade Maior Queda]
			
			VAR AtividadePositiva =
			    [Atividade Maior Crescimento]
			
			RETURN
			
			SWITCH(
			
			    TRUE(),
			
			    //-------------------------------------------------
			    -- CLIENTES SOBEM / TICKET CAI
			    //-------------------------------------------------
			
			    VarClientes > 0
			    && VarTicket < 0,
			
			    "💡 Avaliar estratégias de aumento do ticket médio, priorizando planos premium e serviços de maior valor agregado." &
			
			    UNICHAR(10) &
			    UNICHAR(10) &
			
			    "• Recomenda-se atenção especial à atividade " &
			    AtividadeCritica &
			    ", principal responsável pela retração da receita no período.",
			
			
			    //-------------------------------------------------
			    -- CLIENTES SOBEM / TICKET SOBE
			    //-------------------------------------------------
			
			    VarClientes > 0
			    && VarTicket > 0,
			
			    "💡 Manter a estratégia comercial atual, aproveitando o crescimento saudável da operação." &
			
			    UNICHAR(10) &
			    UNICHAR(10) &
			
			    "• Avaliar expansão da atividade " &
			    AtividadePositiva &
			    ", que apresentou maior contribuição positiva para a receita.",
			
			
			    //-------------------------------------------------
			    -- CLIENTES CAEM / TICKET SOBE
			    //-------------------------------------------------
			
			    VarClientes < 0
			    && VarTicket > 0,
			
			    "💡 Ampliar ações de aquisição de clientes, mantendo foco em produtos e serviços de maior valor agregado." &
			
			    UNICHAR(10) &
			    UNICHAR(10) &
			
			    "• Revisar estratégias de retenção nas atividades com maior retração.",
			
			
			    //-------------------------------------------------
			    -- CLIENTES CAEM / TICKET CAI
			    //-------------------------------------------------
			
			    VarClientes < 0
			    && VarTicket < 0,
			
			    "💡 Revisar estratégias de retenção, precificação e mix de produtos para recuperação da receita." &
			
			    UNICHAR(10) &
			    UNICHAR(10) &
			
			    "• Priorizar ações corretivas na atividade " &
			    AtividadeCritica &
			    ", principal impacto negativo do período.",
			
			
			    //-------------------------------------------------
			    -- PADRÃO
			    //-------------------------------------------------
			
			    "💡 Manter acompanhamento contínuo dos indicadores e oportunidades de crescimento."
			)
		displayFolder: _INSIGHTS
		lineageTag: 679fb28c-1db3-4269-a3bf-9d0c544ba4aa

	measure 'Atividade Maior Crescimento' =
			
			
