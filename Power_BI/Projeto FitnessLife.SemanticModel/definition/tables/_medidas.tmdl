	measure 'Insight Clientes e Ticket' =
			
			
			VAR VarClientes =
			    [% clientes vs ano anterior]
			
			VAR VarTicket =
			    [% ticket medio vs ano anterior]
			
			VAR AnoAtual =
			    SELECTEDVALUE(vw_dim_data[ano])
			
			VAR AnoAnterior =
			    AnoAtual - 1
			
			RETURN
			
			SWITCH(
			
			    TRUE(),
			
			    //-------------------------------------------------
			    -- CLIENTES SOBEM / TICKET CAI
			    //-------------------------------------------------
			
			    VarClientes > 0
			    && VarTicket < 0,
			
			    "📊 A base de clientes aumentou " &
			    FORMAT(ABS(VarClientes), "0,0%") &
			    ", enquanto o ticket médio reduziu " &
			    FORMAT(ABS(VarTicket), "0,0%") &
			    " em relação a " &
			    AnoAnterior & ".",
			
			
			    //-------------------------------------------------
			    -- CLIENTES SOBEM / TICKET SOBE
			    //-------------------------------------------------
			
			    VarClientes > 0
			    && VarTicket > 0,
			
			    "📈 A base de clientes aumentou " &
			    FORMAT(ABS(VarClientes), "0,0%") &
			    " e o ticket médio cresceu " &
			    FORMAT(ABS(VarTicket), "0,0%") &
			    " em relação a " &
			    AnoAnterior & ".",
			
			
			    //-------------------------------------------------
			    -- CLIENTES CAEM / TICKET SOBE
			    //-------------------------------------------------
			
			    VarClientes < 0
			    && VarTicket > 0,
			
			    "📉 A base de clientes reduziu " &
			    FORMAT(ABS(VarClientes), "0,0%") &
			    ", enquanto o ticket médio aumentou " &
			    FORMAT(ABS(VarTicket), "0,0%") &
			    " em relação a " &
			    AnoAnterior & ".",
			
			
			    //-------------------------------------------------
			    -- CLIENTES CAEM / TICKET CAI
			    //-------------------------------------------------
			
			    VarClientes < 0
			    && VarTicket < 0,
			
			    "📉 Tanto a base de clientes quanto o ticket médio apresentaram retração em relação a " &
			    AnoAnterior & ".",
			
			
			    //-------------------------------------------------
			    -- PADRÃO
			    //-------------------------------------------------
			
			    "📊 Os indicadores apresentaram comportamento estável."
			)
		displayFolder: _INSIGHTS
		lineageTag: bacd6a4a-acee-4ea6-8c39-f6dc847d3b7d

