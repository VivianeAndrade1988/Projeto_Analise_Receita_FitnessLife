	measure 'Cor Atividade' =
			
			
			VAR VarReceita =
			    [Crescimento %]
			
			//-----------------------------------------
			// RECEITA DA ATIVIDADE ATUAL
			//-----------------------------------------
			
			VAR ReceitaAtual =
			    [Receita Total]
			
			VAR ImpactoAtual =
			    [Receita Total] - [Receita Ano Anterior]
			
			//-----------------------------------------
			// MAIOR FATURAMENTO
			//-----------------------------------------
			
			VAR MaiorReceita =
			
			    MAXX(
			
			        ALL(vw_dim_atividades[tipo_atividade]),
			
			        CALCULATE([Receita Total])
			    )
			
			//-----------------------------------------
			// MAIOR PREJUÍZO
			//-----------------------------------------
			
			VAR MaiorPrejuizo =
			
			    MINX(
			
			        ALL(vw_dim_atividades[tipo_atividade]),
			
			        CALCULATE(
			            [Receita Total] - [Receita Ano Anterior]
			        )
			    )
			
			RETURN
			
			IF(
			
			    //-----------------------------------------
			    -- RECEITA POSITIVA
			    //-----------------------------------------
			
			    VarReceita > 0,
			
			    IF(
			
			        ReceitaAtual = MaiorReceita,
			
			        "#9DD6D2",     // verde destaque
			
			        "#D1D5DB"      // cinza
			    ),
			
			    //-----------------------------------------
			    -- RECEITA NEGATIVA
			    //-----------------------------------------
			
			    IF(
			
			        ImpactoAtual = MaiorPrejuizo,
			
			        "#DC2626",     // vermelho destaque
			
			        "#D1D5DB"      // cinza
			    )
			)
		displayFolder: _UX
		lineageTag: 9d913ef3-4f3f-4f2a-8f2e-c62c7ee9bab9

