		lineageTag: 94a0005e-c685-41ce-b9c5-0e3d12f98159

	measure 'Valor Grafico Dinamico' = ```
			
			// 1. Captura o número de ordem (ID) do parâmetro que está ativo no gráfico
			VAR SelecaoOrdem = SELECTEDVALUE('Parâm_data'[Parâm_data Pedido]) 
			
			RETURN
			IF (
			    SelecaoOrdem = 0, // 2. Se for 0 (geralmente o Ano), limpa o filtro de ano da tela
			    CALCULATE (
			        [Receita Total],
			        REMOVEFILTERS(vw_dim_data[ano]) 
			    ),
			    [Receita Total] // 3. Se for 1 (Mês), respeita todos os filtros da tela
			)
			
			
			```
		lineageTag: d2c5b9f3-e731-4c6a-b7e0-fd9eb96db1ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Teste Numero' = ```
			SELECTEDVALUE('Parâm_data'[Parâm_data Pedido])
			
			```
		formatString: 0
