	measure 'Variação %' = ```
			
			
			VAR ReceitaAtual =
			    SUM(vw_fato_receita[receita])
			
			VAR ReceitaAnterior =
			    CALCULATE(
			        SUM(vw_fato_receita[receita]),
			        SAMEPERIODLASTYEAR(vw_dim_data[data])
			    )
			
			RETURN
			
			DIVIDE(
			    ReceitaAtual - ReceitaAnterior,
			    ReceitaAnterior
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _GERAL
		lineageTag: 5abe2190-e3b1-4615-948c-e2aef86b03f1

	measure 'Clientes ano anterior' =
			CALCULATE(
			    [qtd total de clientes],
			    DATEADD(vw_dim_data[data],-1,YEAR)
			)
		formatString: 0
		displayFolder: _GERAL
		lineageTag: f3e90045-5525-4e58-931f-fc57ddfee95d

	measure 'Insight Receita' =
			
			
			VAR Variacao = [Crescimento %]
			
			VAR AnoAtual =
			    SELECTEDVALUE(vw_dim_data[ano])
			
			VAR AnoAnterior =
			    AnoAtual - 1
			
			RETURN
			
			IF(
			    Variacao > 0,
			
			    "🟢 A receita apresentou crescimento de " &
			    FORMAT(Variacao, "00%") &
			    " em " &
			    AnoAtual &
			    " comparado a " &
			    AnoAnterior &
			    ".",
			
			    "🔴 A receita apresentou queda de " &
			    FORMAT(ABS(Variacao), "00%") &
			    " em " &
			    AnoAtual &
			    " comparado a " &
			    AnoAnterior &
			    "."
			)
		displayFolder: _INSIGHTS
		lineageTag: d64ea8d2-ec4c-4440-ad74-d92b5dcbac88

	measure 'Atividade Maior Queda' =
			
			
			VAR TabelaModalidade =
			    ADDCOLUMNS(
			        VALUES(vw_dim_atividades[tipo_atividade]),
			        "@Variacao", [Crescimento %]
			    )
			
			VAR MenorValor =
			    MINX(TabelaModalidade, [@Variacao])
			
			RETURN
			    MAXX(
			        FILTER(
			            TabelaModalidade,
			            [@Variacao] = MenorValor
			        ),
			        vw_dim_atividades[tipo_atividade]
			    )
		displayFolder: _UX
		lineageTag: 23cd1c5c-f7bc-4f8b-a674-14925db86e3b

	measure '% clientes vs ano anterior' =
			
			
			var vcliente= [qtd total de clientes]
			var vcliente_ano_anterior = CALCULATE(
			    [qtd total de clientes],
			    SAMEPERIODLASTYEAR(vw_dim_data[data])
			)
			
			return
			
			DIVIDE(
			    vcliente-[Clientes ano anterior],
			    [Clientes ano anterior])
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _UX
		lineageTag: 360a652d-d557-4e69-bc68-11d1ffc9cac3

	measure '% ticket medio vs ano anterior' =
			
			
			var vticket_medio= [Ticket Médio]
			var vticket_medio_ano_anterior = CALCULATE(
			    [Ticket Médio],
			    SAMEPERIODLASTYEAR(vw_dim_data[data])
			)
			
			return
			
			DIVIDE(
			    vticket_medio-vticket_medio_ano_anterior,
			    vticket_medio_ano_anterior)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: _GERAL
		lineageTag: 705f0c23-3b76-4870-89d9-20fcc0e141eb

	measure 'Cor Variação Crescimento' =
			
			
